#!/usr/bin/env python3
"""Auto-nixnan: Collect and report CUDA kernel information from target programs."""

import argparse
import os
import subprocess
import sys
import tempfile
import time
from collections import OrderedDict


def run_with_env(program_args: list, timeout: int, env: dict) -> float:
    """Run the target program with the given environment. Returns wall-clock seconds."""
    start = time.monotonic()
    try:
        subprocess.run(
            program_args,
            env=env,
            check=True,
            timeout=timeout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError as exc:
        print(f"Error: target program exited with code {exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode)
    except subprocess.TimeoutExpired:
        print(f"Error: target program exceeded {timeout}s timeout", file=sys.stderr)
        sys.exit(1)
    return time.monotonic() - start


def _parse_kernel_log(log_file: str) -> tuple[list[str], OrderedDict[str, dict]]:
    """
    Parse a nixnan log file for kernel execution entries.

    Expects lines in the format:
      #nixnan: Kernel [<name>] execution time: <N> microseconds

    Returns (kernels_seq, kernels_unique) where:
      - kernels_seq: ordered list of kernel names in call order
      - kernels_unique: OrderedDict of kernel name -> {"count": int, "total_time_us": float}
    """
    kernels_seq: list[str] = []
    kernels_unique: OrderedDict[str, dict] = OrderedDict()

    with open(log_file, "r") as fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("#nixnan: Kernel ["):
                continue
            bracket_open = line.index("[") + 1
            bracket_close = line.index("]")
            kernel_name = line[bracket_open:bracket_close]
            # Extract execution time in microseconds
            time_us = 0.0
            time_marker = "execution time:"
            if time_marker in line:
                time_str = line[line.index(time_marker) + len(time_marker):].strip()
                # time_str is like "3444 microseconds"
                try:
                    time_us = float(time_str.split()[0])
                except (ValueError, IndexError):
                    time_us = 0.0
            kernels_seq.append(kernel_name)
            if kernel_name not in kernels_unique:
                kernels_unique[kernel_name] = {"count": 0, "total_time_us": 0.0}
            kernels_unique[kernel_name]["count"] += 1
            kernels_unique[kernel_name]["total_time_us"] += time_us

    return kernels_seq, kernels_unique


def collect_kernels(program_args: list, timeout: int, lib_path: str) -> dict:
    """
    Run the target program with nixnan preloaded to collect kernel information.

    Uses LOG_KERNELS to direct output to a temporary log file, then parses it.

    Returns a dict with:
      - kernels_seq: ordered list of kernel names in call order
      - kernels_unique: OrderedDict of kernel name -> {"count": int, "total_time_us": float}
      - elapsed: wall-clock seconds the subprocess ran
    """
    fd, log_file = tempfile.mkstemp(suffix=".log", prefix="nixnan_kernels_")
    os.close(fd)

    env = os.environ.copy()
    env["LD_PRELOAD"] = lib_path
    env["LOG_KERNELS"] = log_file

    elapsed = run_with_env(program_args, timeout, env)

    kernels_seq, kernels_unique = _parse_kernel_log(log_file)
    os.unlink(log_file)

    return {
        "kernels_seq": kernels_seq,
        "kernels_unique": dict(kernels_unique),
        "elapsed": elapsed,
    }


def run_instrumented(program_args: list, timeout: int, lib_path: str) -> dict:
    """
    Run the target program with nixnan preloaded and kernel timing enabled.

    Uses LOGFILE to direct output to a temporary log file and TIME_KERNELS to
    enable kernel timing. Parses the log for the same kernel timing format.

    Returns a dict with the same shape as collect_kernels.
    """
    fd, log_file = tempfile.mkstemp(suffix=".log", prefix="nixnan_instrumented_")
    os.close(fd)

    env = os.environ.copy()
    env["LD_PRELOAD"] = lib_path
    env["LOGFILE"] = log_file
    env["TIME_KERNELS"] = "1"

    elapsed = run_with_env(program_args, timeout, env)

    kernels_seq, kernels_unique = _parse_kernel_log(log_file)
    os.unlink(log_file)

    return {
        "kernels_seq": kernels_seq,
        "kernels_unique": dict(kernels_unique),
        "elapsed": elapsed,
    }


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Collect CUDA kernel information from a target program using nixnan.",
        add_help=True,
    )
    parser.add_argument(
        "-t", "--timeout",
        type=int,
        default=300,
        help="Time limit in seconds for the target program (default: 300)",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        metavar="[-- PROGRAM [ARGS...]]",
        help="Program and arguments to run (precede with --)",
    )

    args = parser.parse_args()

    # Strip leading '--' separator if present
    cmd = args.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    if not cmd:
        parser.error("Please provide a program to run after --")

    # Resolve the nixnan shared library path (relative to this script)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    lib_path = os.path.join(script_dir, "..", "nixnan.so")

    # --- Step 1: Baseline run with kernel logging ---
    baseline = collect_kernels(cmd, args.timeout, lib_path)

    # --- Step 2: Instrumented run with kernel timing ---
    instrumented = run_instrumented(cmd, args.timeout, lib_path)

    # --- Overall overhead calculation ---
    overhead_ms = (instrumented["elapsed"] - baseline["elapsed"]) * 1000
    if baseline["elapsed"] > 0:
        overhead_pct = ((instrumented["elapsed"] - baseline["elapsed"]) / baseline["elapsed"]) * 100
    else:
        overhead_pct = 0.0

    # --- Print results ---
    print("=" * 70)
    print("Auto-nixnan Kernel Report")
    print("=" * 70)
    print()

    # Unique kernels with timing comparison
    all_kernels: OrderedDict[str, None] = OrderedDict()
    for name in baseline["kernels_unique"]:
        all_kernels[name] = None
    for name in instrumented["kernels_unique"]:
        all_kernels[name] = None

    print(f"Unique Kernels ({len(all_kernels)}):")
    for name in all_kernels:
        b_info = baseline["kernels_unique"].get(name, {"count": 0, "total_time_us": 0.0})
        i_info = instrumented["kernels_unique"].get(name, {"count": 0, "total_time_us": 0.0})
        b_count = b_info["count"]
        b_total = b_info["total_time_us"]
        i_count = i_info["count"]
        i_total = i_info["total_time_us"]
        b_avg = b_total / b_count if b_count > 0 else 0.0
        i_avg = i_total / i_count if i_count > 0 else 0.0
        # Slowdown factor: how much slower the instrumented kernel is
        if b_avg > 0:
            slowdown = i_avg / b_avg
        else:
            slowdown = 0.0
        print(f"  {name}")
        print(f"    baseline:    {b_count} call{'s' if b_count != 1 else ''}, {b_total:.0f} us total ({b_avg:.0f} us avg)")
        print(f"    instrumented: {i_count} call{'s' if i_count != 1 else ''}, {i_total:.0f} us total ({i_avg:.0f} us avg)", end="")
        if slowdown > 0:
            print(f"  ({slowdown:.2f}x slowdown)")
        else:
            print()
    print()

    # Timing comparison
    print("Timing:")
    print(f"  Baseline:     {baseline['elapsed']:.3f}s")
    print(f"  Instrumented: {instrumented['elapsed']:.3f}s")
    print(f"  Overhead:     {overhead_ms:+.1f}ms ({overhead_pct:+.1f}%)")
    print()

    # Kernel call sequence (baseline)
    print(f"Kernel Call Sequence ({len(baseline['kernels_seq'])} calls):")
    for idx, name in enumerate(baseline["kernels_seq"], start=1):
        print(f"  {idx:04d}. {name}")


if __name__ == "__main__":
    main()
