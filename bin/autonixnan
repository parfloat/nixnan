#!/usr/bin/env python3
"""Auto-nixnan: Collect and report CUDA kernel information from target programs."""

import argparse
import os
import subprocess
import sys
import tempfile
import time
from collections import OrderedDict


def run_with_env(program_args: list, timeout: int, env: dict) -> float:
    """Run the target program with the given environment. Returns wall-clock seconds."""
    start = time.monotonic()
    try:
        subprocess.run(
            program_args,
            env=env,
            check=True,
            timeout=timeout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError as exc:
        print(f"Error: target program exited with code {exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode)
    except subprocess.TimeoutExpired:
        print(f"Error: target program exceeded {timeout}s timeout", file=sys.stderr)
        sys.exit(1)
    return time.monotonic() - start


def collect_kernels(program_args: list, timeout: int, lib_path: str) -> dict:
    """
    Run the target program with nixnan preloaded to collect kernel information.

    Manages its own temporary log file (create, run, parse, cleanup).

    Returns a dict with:
      - kernels_seq: ordered list of kernel names in call order
      - kernels_unique: dict of unique kernel names with call counts
      - elapsed: wall-clock seconds the subprocess ran
    """
    fd, log_file = tempfile.mkstemp(suffix=".log", prefix="nixnan_kernels_")
    os.close(fd)

    env = os.environ.copy()
    env["LD_PRELOAD"] = lib_path
    env["LOG_KERNELS"] = log_file

    elapsed = run_with_env(program_args, timeout, env)

    # Parse the log file
    kernels_seq: list[str] = []
    kernels_unique: OrderedDict[str, int] = OrderedDict()

    with open(log_file, "r") as fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("#nixnan: kernel ["):
                continue
            bracket_open = line.index("[") + 1
            bracket_close = line.index("]")
            kernel_name = line[bracket_open:bracket_close]
            kernels_seq.append(kernel_name)
            kernels_unique[kernel_name] = kernels_unique.get(kernel_name, 0) + 1

    # Cleanup
    os.unlink(log_file)

    return {
        "kernels_seq": kernels_seq,
        "kernels_unique": dict(kernels_unique),
        "elapsed": elapsed,
    }


def run_instrumented(program_args: list, timeout: int, lib_path: str) -> float:
    """Run the target program with nixnan preloaded (no logging) to measure instrumentation overhead."""
    env = os.environ.copy()
    env["LD_PRELOAD"] = lib_path
    return run_with_env(program_args, timeout, env)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Collect CUDA kernel information from a target program using nixnan.",
        add_help=True,
    )
    parser.add_argument(
        "-t", "--timeout",
        type=int,
        default=300,
        help="Time limit in seconds for the target program (default: 300)",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        metavar="[-- PROGRAM [ARGS...]]",
        help="Program and arguments to run (precede with --)",
    )

    args = parser.parse_args()

    # Strip leading '--' separator if present
    cmd = args.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    if not cmd:
        parser.error("Please provide a program to run after --")

    # Resolve the nixnan shared library path (relative to this script)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    lib_path = os.path.join(script_dir, "..", "nixnan.so")

    # --- Step 1: Baseline run with kernel logging ---
    result = collect_kernels(cmd, args.timeout, lib_path)
    baseline_time = result["elapsed"]

    # --- Step 2: Instrumented run (LD_PRELOAD only, no logging) ---
    instrumented_time = run_instrumented(cmd, args.timeout, lib_path)

    # --- Overhead calculation ---
    overhead_ms = (instrumented_time - baseline_time) * 1000
    if baseline_time > 0:
        overhead_pct = ((instrumented_time - baseline_time) / baseline_time) * 100
    else:
        overhead_pct = 0.0

    # --- Print results ---
    print("=" * 70)
    print("Auto-nixnan Kernel Report")
    print("=" * 70)
    print()

    # Unique kernel names
    print(f"Unique Kernels ({len(result['kernels_unique'])}):")
    for name, count in result["kernels_unique"].items():
        print(f"  {name} (called {count} time{'s' if count > 1 else ''})")
    print()

    # Timing comparison
    print("Timing:")
    print(f"  Baseline (with kernel logging): {baseline_time:.3f}s")
    print(f"  Instrumented (LD_PRELOAD only): {instrumented_time:.3f}s")
    print(f"  Instrumentation overhead:       {overhead_ms:+.1f}ms ({overhead_pct:+.1f}%)")
    print()

    # Kernel call sequence
    print(f"Kernel Call Sequence ({len(result['kernels_seq'])} calls):")
    for idx, name in enumerate(result["kernels_seq"], start=1):
        print(f"  {idx:04d}. {name}")


if __name__ == "__main__":
    main()
